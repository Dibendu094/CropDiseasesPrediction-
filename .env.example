# ══════════════════════════════════════════════════════════════
#  Crop Disease Prediction — configuration template
#
#  Copy to `.env` and fill in your own values:
#      cp .env.example .env          (Windows: copy .env.example .env)
#
#  `.env` is git-ignored. Never commit real credentials.
#
#  Everything here is OPTIONAL — the app boots with sensible
#  defaults and stores data in a local SQLite file.
# ══════════════════════════════════════════════════════════════


# ──────────────────────────────────────────────────────────────
#  SERVER
# ──────────────────────────────────────────────────────────────
# Port to serve on.
PORT=5000

# 1 = auto-reload + debugger (development).  0 = quiet.
FLASK_DEBUG=1

# Signs session cookies. If unset, a temporary key is generated and
# every restart logs all users out — set a real one to keep sessions.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-me


# ──────────────────────────────────────────────────────────────
#  DATABASE
#  Each user gets their own Postgres schema (user_<uuid>) holding a
#  private `detections` table. Registry lives in agricare.users.
#
#  auto     = try Postgres, fall back to local SQLite if unreachable
#  sqlite   = always use the local file (no cloud database needed)
#  postgres = require Postgres and fail loudly if it is down
# ──────────────────────────────────────────────────────────────
DB_BACKEND=auto
SQLITE_PATH=agricare_local.db

# ── Supabase Postgres (leave blank to run purely on SQLite) ──
#
#  IMPORTANT: Supabase retired the old direct hostname
#      db.<project-ref>.supabase.co      <- no longer resolves in DNS
#  Use the POOLER. Copy the values from:
#      Supabase > Project Settings > Database > Transaction pooler
#
#  Two things people get wrong:
#    * the pooler port is 6543, not 5432
#    * the username is postgres.<project-ref>, not plain postgres
DB_HOST=aws-0-<your-region>.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_USER=postgres.<your-project-ref>
DB_PASSWORD=your-database-password
DB_SSLMODE=require

# Supabase REST/Auth endpoints (optional — not needed for Postgres above).
# The publishable key is public by design and safe in a browser.
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx


# ──────────────────────────────────────────────────────────────
#  GOOGLE SIGN-IN  (optional — leave blank to hide the button)
#
#  console.cloud.google.com/apis/credentials
#    > Create credentials > OAuth client ID > Web application
#    > Authorised JavaScript origins:
#          http://localhost:5000
#    > Authorised redirect URIs:  LEAVE EMPTY
#      (this app uses the JavaScript credential callback, so Google
#       never redirects back to the server)
# ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=


# ──────────────────────────────────────────────────────────────
#  PREDICTION MODEL
#    cascade      ViT-B/16 answers; if under CASCADE_THRESHOLD%
#                 confident, EfficientNet-B3 decides    (default)
#    vit          ViT-B/16-384 alone
#    efficientnet EfficientNet-B3 alone
#    ensemble     weighted average of both
# ──────────────────────────────────────────────────────────────
PREDICTION_MODEL=cascade
CASCADE_THRESHOLD=70

# Weights used only in 'ensemble' mode
ENSEMBLE_WEIGHT_VIT=0.70
ENSEMBLE_WEIGHT_EFF=0.30


# ──────────────────────────────────────────────────────────────
#  MODEL CHECKPOINTS
#  The two .pth files total ~1.1 GB and are NOT in the repo.
#  Normally you just drop them into backend/models/.
#  Optionally, host them somewhere with direct download links
#  (e.g. a GitHub Release) and set the URLs here —
#  backend/model_store.py fetches anything missing on first boot.
# ──────────────────────────────────────────────────────────────
MODEL_URL_EFFICIENTNET=
MODEL_URL_VIT=


# ──────────────────────────────────────────────────────────────
#  GEMINI  (optional — identifies crops outside the 31-crop list)
#  Free key: https://aistudio.google.com/app/apikey
# ──────────────────────────────────────────────────────────────
GEMINI_API_KEY=

# Google retires hosted model ids over time. On a 404 or a 429 with
# "limit: 0", pick a current model in AI Studio and update this.
GEMINI_MODEL=gemini-flash-lite-latest

# Tried in order when the primary is overloaded (503) or retired (404)
GEMINI_FALLBACK_MODELS=gemini-flash-latest,gemini-3.5-flash-lite,gemini-3.5-flash

# Retries per model for transient "high demand" errors
GEMINI_MAX_RETRIES=2


# ──────────────────────────────────────────────────────────────
#  DAILY QUOTAS  (per browser session, reset at midnight)
# ──────────────────────────────────────────────────────────────
DAILY_SCANS_SIGNED_IN=100
DAILY_SCANS_GUEST=50

# The unlisted-crop path costs an API call, so it is capped separately
DAILY_GEMINI_SIGNED_IN=10
DAILY_GEMINI_GUEST=10

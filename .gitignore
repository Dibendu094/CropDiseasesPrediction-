# ══════════════════════════════════════════════════════════════
#  SECRETS — never commit these
# ══════════════════════════════════════════════════════════════
.env
.env.*
.env.example
*.pem
*.key
*credentials*.json
*service-account*.json
secrets.json


# ══════════════════════════════════════════════════════════════
#  TRAINED MODELS  (~1.1 GB — exceeds GitHub's 100 MB file limit)
#  Distribute via Releases, Git LFS, or a cloud bucket instead.
# ══════════════════════════════════════════════════════════════
*.pth
*.pt
*.ckpt
*.h5
*.onnx
*.pkl
backend/models/*
!backend/models/README.md


# ══════════════════════════════════════════════════════════════
#  USER DATA
# ══════════════════════════════════════════════════════════════
uploads/*
!uploads/.gitkeep
agricare_local.db
agricare_local.db-wal
agricare_local.db-shm
*.sqlite
*.sqlite3



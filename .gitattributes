# Normalise line endings so the repo is consistent across Windows/Linux/macOS
# and Render (Linux) gets LF regardless of who committed.
* text=auto eol=lf

# Windows-only scripts must keep CRLF or cmd.exe misreads them
*.bat text eol=crlf
*.ps1 text eol=crlf

# Shell scripts must be LF or they fail on Linux
*.sh  text eol=lf

# Binary — never touch
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.pth  binary
*.pt   binary
*.pkl  binary
*.onnx binary

# Keep generated/vendor files out of language stats and diffs
docs/screenshots/*  linguist-documentation
crop_disease_system/*  linguist-vendored
